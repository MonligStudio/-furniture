# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.

PORT=4100
NODE_ENV=development

# Frontend adresleri (virgülle ayrılır) — CORS bu listeye göre açılır.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5310

# /api/admin/* uçlarının beklediği `x-admin-token` değeri.
# YAYINA ÇIKMADAN ÖNCE DEĞİŞTİRİN.
ADMIN_TOKEN=escudo-degistir

# Form kayıtlarının yazıldığı dosya (data/ altında oluşur).
DB_FILE=escudo.json
